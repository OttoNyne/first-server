PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
JWT_SECRET=replace-with-a-long-random-string
# One frontend address, or several separated by commas (the first is used for links in emails)
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Password-reset email (optional; without these, reset by email is reported as unavailable in production)
RESEND_API_KEY=
MAIL_FROM=CreativesSelect <noreply@your-verified-domain.com>
# Optional: TURN relay for live audio on networks that block direct connections, e.g.
# LIVE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
LIVE_ICE_SERVERS=

# Voice lives for 50-100 listeners go through a LiveKit media server (free account at cloud.livekit.io).
# Without these three, lives are browser-to-browser and limited to 8 listeners.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: 50 (default) to 100
LIVE_MAX_LISTENERS=

# Optional: set to true to keep going live and posting public Help wanted requests for people who have confirmed their email.
REQUIRE_VERIFIED_EMAIL=
